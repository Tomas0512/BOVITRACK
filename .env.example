# ══════════════════════════════════════════════════════════════
# BoviTrack — Plantilla de variables de entorno
#
# What?    Copia este archivo como .env y completa los valores.
# ¿Para?   Sirve de referencia documentada para cualquier
#           desarrollador que clone el repositorio.
# Impact? Sin este archivo, quien clona el repo no sabe qué
#           variables son necesarias ni qué formato tienen.
# ══════════════════════════════════════════════════════════════

# ─── Base de datos ────────────────────────────────
POSTGRES_USER=<usuario_de_la_bd>
POSTGRES_PASSWORD=<contraseña_segura>
POSTGRES_DB=<nombre_de_la_bd>

# ─── JWT ──────────────────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── URLs ─────────────────────────────────────────
# Con Docker (fe en nginx interno :80 publicado en 5173): http://localhost:5173
# Sin Docker (Vite dev): http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Con Docker (nginx proxia /api/): /api/v1
# Sin Docker (acceso directo): http://localhost:8000/api/v1
VITE_API_URL=/api/v1

# ─── Email: backend de entrega seleccionable ──────
# Valores: mailpit | smtp | resend | log
#   mailpit → SMTP local de desarrollo (Mailpit). Dev, NO entrega real.
#   smtp    → correo real vía SMTP (Gmail, etc.). Requiere SMTP_* de abajo.
#   resend  → correo real vía Resend API. Requiere RESEND_API_KEY.
#   log     → solo imprime en consola (con el enlace, útil para probar en local).
#
# Desarrollo: "log" (el docker-compose.yml ya no incluye un servicio Mailpit; para
#   usarlo, levántalo aparte y pon EMAIL_BACKEND=mailpit, SMTP_HOST=<host>, SMTP_PORT=1025).
# Producción: SOLO smtp o resend. Con mailpit o log la API NO arranca, y si un envío
#   falla, el enlace (que lleva un token) NO se escribe en los logs.
EMAIL_BACKEND=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
# Credenciales para SMTP real (Gmail):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USERNAME=tu-email@gmail.com
# SMTP_PASSWORD=contraseña-de-aplicación

# ─── Email: Resend API (correo real) ──────────────
# Para EMAIL_BACKEND=resend. El dominio de RESEND_FROM_EMAIL debe estar verificado.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@bovitrack.com
RESEND_FROM_NAME=BoviTrack

# ─── Rate limiting ─────────────────────────────────
# true (default, recomendado): aplica límites de auth (5/min login, 3/min recuperación).
# false: SOLO para desarrollo/QA local — la suite E2E (qa_e2e/) hace ~15 logins
# por corrida y sin esto recibiría 429. NUNCA usar false en producción
# (docker-compose.prod.yml lo fija en true y la API se niega a arrancar sin él).
RATE_LIMIT_ENABLED=true

# ─── Entorno ───────────────────────────────────────
# development (por defecto) | test | staging | production
# El docker-compose.yml (desarrollo) usa "development"; docker-compose.prod.yml
# fija "production": sin /docs ni /openapi.json, CORS solo FRONTEND_URL, sin --reload
# y validación de la configuración al arrancar.
# ENVIRONMENT=development

# ─── Solo producción (docker-compose.prod.yml) ─────
# Procesos de la API. El bloqueo por intentos de login vive en la BD (tabla
# login_attempt), así que es el mismo para todos los procesos.
# WEB_CONCURRENCY=1
# Dónde publica nginx (la única entrada). Por defecto 127.0.0.1:8080, detrás de un
# proxy con HTTPS (Caddy, Cloudflare Tunnel...). 0.0.0.0 lo expone directamente.
# HTTP_BIND=127.0.0.1
# HTTP_PORT=8080
# Cada cuántos minutos se revisan y envían las alertas sanitarias y de stock.
# NOTIFICATIONS_INTERVAL_MINUTES=15
