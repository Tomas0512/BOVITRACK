storage/

# Pruebas y cachés de herramientas: no se usan en la imagen
tests/
.ruff_cache/
.import_linter_cache/

# Scripts de datos de prueba y de depuración: útiles en desarrollo (que monta
# ./be), pero no deben poder ejecutarse dentro de la imagen de producción.
seed_test_data.py
