# Entorno virtual
.venv/

# Cache de Python
__pycache__/
*.pyc
*.pyo

# Tests y cobertura
.pytest_cache/
htmlcov/
.coverage

# IDE
.vscode/
.idea/

# Variables de entorno locales
.env

# Alembic cache
alembic/__pycache__/
alembic/versions/__pycache__/

# Git
.git/
.gitignore

# Archivos subidos por los usuarios: NUNCA dentro de la imagen (en producción
