# ─── Base de datos ────────────────────────────────
DATABASE_URL=postgresql://bovitrack_user:bovitrack_pass@localhost:5432/bovitrack_db

# ─── JWT ──────────────────────────────────────────
SECRET_KEY=cambia-esta-clave-secreta-en-produccion
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Email — Resend ───────────────────────────────
# Obtener API key en: https://resend.com/api-keys
# Capa gratuita: 3,000 emails/mes
# Si se deja vacío, los emails se simulan (el enlace aparece en los logs del servidor).
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=BoviTrack

# ─── Email — SMTP (alternativa a Resend) ──────────
# Para desarrollo con Docker: SMTP_HOST=mailpit, SMTP_PORT=1025
# (ya configurado en docker-compose.yml)
# Para desarrollo fuera de Docker:
# SMTP_HOST=localhost
# SMTP_PORT=1025
SMTP_HOST=
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=

# ─── Frontend ─────────────────────────────────────
FRONTEND_URL=http://localhost:5173
