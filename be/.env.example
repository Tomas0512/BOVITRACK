# ─── Base de datos ────────────────────────────────
DATABASE_URL=postgresql://bovitrack_user:bovitrack_pass@localhost:5432/bovitrack_db

# ─── JWT ──────────────────────────────────────────
SECRET_KEY=cambia-esta-clave-secreta-en-produccion
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Frontend ─────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Email: backend de entrega ─────────────────────
# Valores: mailpit | smtp | resend | log
#   mailpit → SMTP local de desarrollo (Mailpit en Docker).
#   smtp    → correo real vía SMTP (Gmail, etc.).
#   resend  → correo real vía Resend API (usa RESEND_API_KEY).
#   log     → solo imprime en consola.
EMAIL_BACKEND=mailpit

# ─── Email SMTP ────────────────────────────────────
# Mailpit (Docker): SMTP_HOST y SMTP_PORT se pasan desde docker-compose
# Gmail (desarrollo local sin Docker):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=tu-email@gmail.com
#   SMTP_PASSWORD=contraseña-de-aplicación
#   EMAIL_BACKEND=smtp
SMTP_HOST=
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=

# ─── Email Resend (correo real vía API) ────────────
# Para EMAIL_BACKEND=resend. Requiere dominio verificado para RESEND_FROM_EMAIL.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@bovitrack.com
RESEND_FROM_NAME=BoviTrack
