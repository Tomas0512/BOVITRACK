{
  "info": {
    "name": "BoviTrack API - Suite Automatizada",
    "description": "Suite automatizada (punto 3.4) para BoviTrack. Flujo: Login → Refresh → Perfil → Fincas → CRUD de bovinos → Reportes. Encadenamiento dinámico mediante variables de environment ({{accessToken}}, {{farmId}}, {{bovineId}}). Requiere el environment 'BoviTrack - Local'.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "",
                  "pm.test(\"Autenticación exitosa y extracción de access_token\", function () {",
                  "    pm.expect(jsonData).to.have.property(\"access_token\");",
                  "    pm.expect(jsonData.access_token).to.be.a('string').and.not.empty;",
                  "    pm.environment.set(\"accessToken\", jsonData.access_token);",
                  "    pm.environment.set(\"refreshToken\", jsonData.refresh_token);",
                  "});",
                  "",
                  "pm.test(\"El refresh_token es un string no vacío\", function () {",
                  "    pm.expect(jsonData.refresh_token).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@bovitrack.com\",\n  \"password\": \"Demo1234!\"\n}"
            }
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Refresh token responde 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "",
                  "pm.test(\"El nuevo access_token se guarda en el environment\", function () {",
                  "    pm.expect(jsonData).to.have.property(\"access_token\");",
                  "    pm.expect(jsonData.access_token).to.be.a('string').and.not.empty;",
                  "    pm.environment.set(\"accessToken\", jsonData.access_token);",
                  "    pm.environment.set(\"refreshToken\", jsonData.refresh_token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/refresh",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Perfil y Finca",
      "item": [
        {
          "name": "Get My Profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "",
                  "pm.test(\"El email del usuario es un string\", function () {",
                  "    pm.expect(jsonData.email).to.be.a('string');",
                  "});",
