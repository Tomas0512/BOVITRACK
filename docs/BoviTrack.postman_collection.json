                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ]
          }
        },
        {
          "name": "Update Bovine",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Actualización correcta de datos - 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
