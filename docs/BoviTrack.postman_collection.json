            "url": "{{baseUrl}}/api/v1/farms/{{farmId}}/alerts/history/{{notificationId}}/read",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ]
          }
        }
      ]
    }
  ]
}
