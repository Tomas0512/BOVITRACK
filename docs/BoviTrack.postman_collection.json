{
  "info": {
    "name": "BoviTrack API - Suite Automatizada",
    "description": "Suite automatizada (punto 3.4) para BoviTrack. Flujo: Login → Refresh → Perfil → Fincas → CRUD de bovinos → Reportes. Encadenamiento dinámico mediante variables de environment ({{accessToken}}, {{farmId}}, {{bovineId}}). Requiere el environment 'BoviTrack - Local'.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "",
                  "pm.test(\"Autenticación exitosa y extracción de access_token\", function () {",
                  "    pm.expect(jsonData).to.have.property(\"access_token\");",
                  "    pm.expect(jsonData.access_token).to.be.a('string').and.not.empty;",
                  "    pm.environment.set(\"accessToken\", jsonData.access_token);",
                  "    pm.environment.set(\"refreshToken\", jsonData.refresh_token);",
                  "});",
                  "",
                  "pm.test(\"El refresh_token es un string no vacío\", function () {",
                  "    pm.expect(jsonData.refresh_token).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@bovitrack.com\",\n  \"password\": \"Demo1234!\"\n}"
            }
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Refresh token responde 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "",
                  "pm.test(\"El nuevo access_token se guarda en el environment\", function () {",
                  "    pm.expect(jsonData).to.have.property(\"access_token\");",
                  "    pm.expect(jsonData.access_token).to.be.a('string').and.not.empty;",
                  "    pm.environment.set(\"accessToken\", jsonData.access_token);",
                  "    pm.environment.set(\"refreshToken\", jsonData.refresh_token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/refresh",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Perfil y Finca",
      "item": [
        {
          "name": "Get My Profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "",
                  "pm.test(\"El email del usuario es un string\", function () {",
                  "    pm.expect(jsonData.email).to.be.a('string');",
                  "});",
                  "",
                  "pm.test(\"El id del usuario existe\", function () {",
                  "    pm.expect(jsonData.id).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/users/me",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ]
          }
        },
        {
          "name": "List My Farms",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"La respuesta es un arreglo de fincas\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "    pm.expect(jsonData.length).to.be.greaterThan(0);",
                  "    pm.expect(jsonData[0]).to.have.property(\"id\");",
                  "    pm.environment.set(\"farmId\", jsonData[0].id);",
                  "});",
                  "",
                  "pm.test(\"farmId quedó almacenado en el environment\", function () {",
                  "    pm.expect(pm.environment.get(\"farmId\")).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/farms",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ]
          }
        },
        {
          "name": "Get Farm Detail",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "",
                  "pm.test(\"El nombre de la finca es un string\", function () {",
                  "    pm.expect(jsonData.name).to.be.a('string');",
                  "});",
                  "",
                  "pm.test(\"El id de la finca coincide con farmId\", function () {",
                  "    pm.expect(jsonData.id).to.equal(pm.environment.get(\"farmId\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/farms/{{farmId}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Bovinos - CRUD",
      "item": [
        {
          "name": "Create Bovine",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Creación de bovino exitosa - 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "",
                  "pm.test(\"Estructura JSON válida y persistencia de bovineId\", function () {",
                  "    pm.expect(jsonData).to.have.property(\"id\");",
                  "    pm.expect(jsonData.identification_number).to.be.a('string');",
                  "    pm.expect(jsonData.is_active).to.be.true;",
                  "    pm.environment.set(\"bovineId\", jsonData.id);",
                  "});",
                  "",
                  "pm.test(\"bovineId quedó almacenado en el environment\", function () {",
                  "    pm.expect(pm.environment.get(\"bovineId\")).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/farms/{{farmId}}/bovines",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Vaquilla QA\",\n  \"identification_number\": \"QA-{{$timestamp}}\",\n  \"sex\": \"hembra\",\n  \"breed\": \"Normando\",\n  \"color\": \"Rojo\",\n  \"birth_date\": \"2024-01-15\",\n  \"birth_weight\": 38,\n  \"purpose\": \"leche\",\n  \"entry_type\": \"nacimiento\",\n  \"entry_date\": \"2024-01-15\"\n}"
            }
          }
        },
        {
          "name": "List Bovines",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "",
                  "pm.test(\"La respuesta es un arreglo de bovinos\", function () {",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "});",
                  "",
                  "pm.test(\"Cada bovino listado tiene id y identification_number\", function () {",
                  "    if (jsonData.length > 0) {",
                  "        pm.expect(jsonData[0]).to.have.property(\"id\");",
                  "        pm.expect(jsonData[0]).to.have.property(\"identification_number\");",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/farms/{{farmId}}/bovines",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ]
          }
        },
        {
          "name": "Get Bovine Detail",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "",
                  "pm.test(\"El id del bovino coincide con bovineId\", function () {",
                  "    pm.expect(jsonData.id).to.equal(pm.environment.get(\"bovineId\"));",
                  "});",
                  "",
                  "pm.test(\"El bovino tiene nombre e identification_number\", function () {",
                  "    pm.expect(jsonData).to.have.property(\"name\");",
                  "    pm.expect(jsonData.identification_number).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/farms/{{farmId}}/bovines/{{bovineId}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ]
          }
        },
        {
          "name": "Update Bovine",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Actualización correcta de datos - 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "",
                  "pm.test(\"El bovino actualizado tiene updated_at\", function () {",
                  "    pm.expect(jsonData.updated_at).to.exist;",
                  "    pm.expect(jsonData.updated_at).to.be.a('string');",
                  "});",
                  "",
                  "pm.test(\"El nombre fue actualizado\", function () {",
                  "    pm.expect(jsonData.name).to.equal(\"Vaquilla QA - Actualizada\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/v1/farms/{{farmId}}/bovines/{{bovineId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Vaquilla QA - Actualizada\",\n  \"current_weight\": 260\n}"
            }
          }
        },
        {
          "name": "Delete Bovine",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Eliminación exitosa - 200 OK o 204 No Content\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
                  "});",
                  "",
                  "pm.test(\"La respuesta no contiene contenido\", function () {",
                  "    pm.expect(pm.response.text()).to.be.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/farms/{{farmId}}/bovines/{{bovineId}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Reportes",
      "item": [
        {
          "name": "Farm Statistics",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "",
                  "pm.test(\"La respuesta de estadísticas es un objeto JSON\", function () {",
                  "    pm.expect(jsonData).to.be.an('object');",
                  "    pm.expect(jsonData).to.not.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/farms/{{farmId}}/statistics",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ]
          }
        }
      ]
    }
  ]
}
