                  "    pm.environment.set(\"bovineId\", jsonData.id);",
                  "});",
                  "",
                  "pm.test(\"bovineId quedó almacenado en el environment\", function () {",
                  "    pm.expect(pm.environment.get(\"bovineId\")).to.be.a('string').and.not.empty;",
